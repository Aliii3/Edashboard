# Copy to .env for local use. Never commit .env. On Vercel, set these in Project Settings.
DATABASE_URL=postgres://localhost:5432/commerce_os
PORT=3001
NODE_ENV=development
COOKIE_SECURE=0
# First owner login, created when no logins exist yet.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Password for demo logins created by `npm run db:seed`.
SEED_PASSWORD=
# Optional: 1 enables demo reset and the load test, 0 disables them.
DEMO_TOOLS=
# Vercel production only: apply database migrations during the build.
MIGRATE_ON_BUILD=
